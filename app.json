{
  "expo": {
    "name": "IrangaMg",
    "slug": "IrangaMg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/notification-icon.png",
    "scheme": "irangamg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df61d192-6f4a-48d9-b5b5-7d074c9c7a4e"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mg.adiresiko.irangamg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "mg.adiresiko.irangamg",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
